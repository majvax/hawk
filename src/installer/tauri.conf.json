{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawk Setup",
  "identifier": "app.hawk.setup",
  "build": {
    "frontendDist": "../server/frontend/dist-setup"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hawk Setup",
        "width": 940,
        "height": 640,
        "minWidth": 780,
        "minHeight": 580,
        "center": true,
        "backgroundColor": "#08090a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icons/icon.ico", "../../assets/icons/icon.png"]
  }
}
