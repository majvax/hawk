{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawk",
  "identifier": "app.hawk.desktop",
  "build": {
    "frontendDist": "../server/frontend/dist-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hawk",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#08090a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Hawk",
    "shortDescription": "Hawk remote desktop",
    "longDescription": "The Hawk dashboard as a desktop app: your machines, end-to-end encrypted, with updates signed by the project.",
    "icon": [
      "../../assets/icons/32x32.png",
      "../../assets/icons/128x128.png",
      "../../assets/icons/128x128@2x.png",
      "../../assets/icons/icon.icns",
      "../../assets/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
